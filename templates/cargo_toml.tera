[package]
name = "{{ crate_name }}"
version = "0.1.0"
edition = "2021"
description = "Generated SDK for {{ base_url }}"

[dependencies]
{{ http_client_crate }} = { version = "0.12", features = ["json"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
thiserror = "2"
tokio = { version = "1", features = ["rt-multi-thread", "macros"] }
