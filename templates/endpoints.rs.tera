//! Typed endpoint methods.

#[allow(unused_imports)]
use crate::types::*;
use crate::client::ApiClient;
use crate::error::ApiError;

impl ApiClient {
{% for method in methods %}
    /// {{ method.doc_comment }}
    pub async fn {{ method.fn_name }}(
        &self,
{% for p in method.path_params %}
        {{ p.name }}: {{ p.rust_type }},
{% endfor %}
{% for p in method.query_params %}
        {{ p.name }}: {{ p.rust_type }},
{% endfor %}
{% if method.request_body_type %}
        body: &{{ method.request_body_type }},
{% endif %}
    ) -> Result<{{ method.response_type }}, ApiError> {
        let url = format!("{}{}", self.base_url, format!("{{ method.path_format_str }}"{% for p in method.path_params %}, {{ p.name }}{% endfor %}));
        let req = self.http.{{ method.http_method }}(&url);
{% for p in method.query_params %}
{% if p.is_optional %}
        let req = if let Some(ref val) = {{ p.name }} {
            req.query(&[("{{ p.name }}", val.to_string())])
        } else {
            req
        };
{% else %}
        let req = req.query(&[("{{ p.name }}", {{ p.name }}.to_string())]);
{% endif %}
{% endfor %}
{% if method.request_body_type %}
        let req = req.json(body);
{% endif %}
        let resp = self.send(req).await?;
{% if method.response_type == "()" %}
        let _ = resp;
        Ok(())
{% else %}
        resp.json().await.map_err(ApiError::Deserialize)
{% endif %}
    }
{% endfor %}
}
