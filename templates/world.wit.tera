/// Auto-generated by SDK Forge from recorded API traffic.
/// API: {{ base_url }}

package {{ package_name }}:api;
{% if auth %}

/// Authentication configuration.
record {{ auth.wit_name }} {
{% for field in auth.fields %}
    /// {{ field.doc_comment }}
    {{ field.wit_name }}: {{ field.wit_type }},
{% endfor %}
}
{% endif %}

/// Error returned by API operations.
record api-error {
    /// HTTP status code (0 if no response received).
    status-code: u16,
    /// Error message or response body.
    message: string,
}
{% for record in records %}

/// {{ record.doc_comment }}
record {{ record.wit_name }} {
{% for field in record.fields %}
    {{ field.wit_name }}: {{ field.wit_type }},
{% endfor %}
}
{% endfor %}
{% for iface in interfaces %}

/// {{ iface.doc_comment }}
interface {{ iface.wit_name }} {
{% for func in iface.functions %}
    /// {{ func.doc_comment }}
    {{ func.wit_name }}: func({% for p in func.path_params %}{{ p.wit_name }}: {{ p.wit_type }}, {% endfor %}{% for p in func.query_params %}{{ p.wit_name }}: {{ p.wit_type }}, {% endfor %}{% if func.request_body_wit %}body: {{ func.request_body_wit }}, {% endif %}{% if auth and func.requires_auth %}auth: {{ auth.wit_name }}, {% endif %}) -> result<{{ func.response_wit }}, api-error>;
{% endfor %}
}
{% endfor %}

world sdk {
    import wasi:http/outgoing-handler@0.2.8;
{% for iface in interfaces %}
    export {{ iface.wit_name }};
{% endfor %}
}
